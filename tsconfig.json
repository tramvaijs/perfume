{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "lib": ["es2015", "es2016", "es2017", "dom"],
    "types": ["jest"],
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declarationMap": true,
    "skipLibCheck": true
  },
  "include": ["src", "__tests__"]
}
